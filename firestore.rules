rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function scopeOK(scope) {
      return scope.matches('^[a-f0-9]{64}$');
    }
    function sealed(value) {
      return value is map
        && value.keys().hasOnly(['iv', 'cipher'])
        && value.iv is string && value.iv.size() == 16
        && value.cipher is string
        && value.cipher.size() > 20 && value.cipher.size() <= 800000;
    }
    match /shadowlab/{scope}/entries/{entry} {
      // The random private link is the capability. No account is required.
      allow get, list: if scopeOK(scope);
      allow create, update: if scopeOK(scope)
        && entry.matches('^[A-Za-z0-9_-]{1,80}$')
        && request.resource.data.keys().hasOnly(['schema', 'revision', 'deleted', 'updatedAt', 'payload'])
        && request.resource.data.schema == 3
        && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0
        && request.resource.data.revision.size() <= 80
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt > 0
        && sealed(request.resource.data.payload);
      allow delete: if scopeOK(scope);
    }
    match /shadowlab/{scope}/blobs/{chunk} {
      allow get, delete: if scopeOK(scope)
        && chunk.matches('^[a-f0-9]{64}-[0-9]{1,3}$');
      allow create, update: if scopeOK(scope)
        && chunk.matches('^[a-f0-9]{64}-[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['schema', 'iv', 'cipher'])
        && request.resource.data.schema == 3
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.cipher is string
        && request.resource.data.cipher.size() > 20
        && request.resource.data.cipher.size() <= 800000;
      allow list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
